---
import I18NDebug from "@ariaskit/astro-i18n/I18NDebug.astro";

type Option = { key: string; value: string | number };

interface Content {
    title: Option;
    category: Option;
    description: Option;
    experience_years: Option;
    experience_label: Option;
}

interface Props {
    heading: Option;
    content: Content[];
}

const { heading, content } = Astro.props as Props;
---

<section class="mt-20">
    <I18NDebug key={heading.key}>
        <h2 class="opacity-50 uppercase mb-6">{heading.value}</h2>
    </I18NDebug>
    <div class="grid grid-cols-1 gap-px md:grid-cols-3">
        {
            content.map((skill) => (
                <article class="border p-5 min-h-64 flex flex-col gap-4">
                    <div class="flex flex-col gap-3">
                        <I18NDebug key={skill.title.key}>
                            <p class="text-green-500 break-words leading-tight text-[1.8rem] md:text-[1.5rem]">
                                {">"} {skill.title.value}
                            </p>
                        </I18NDebug>

                        <I18NDebug key={skill.category.key}>
                            <span class="text-[0.7rem] p-1 text-white/70 uppercase">{skill.category.value}</span>
                        </I18NDebug>

                        <I18NDebug key={skill.description.key}>
                            <p class="text-[0.95rem] opacity-50 pb-3 border-b min-h-[4.5rem] leading-8 break-words">
                                {skill.description.value}
                            </p>
                        </I18NDebug>
                    </div>

                    <div class="mt-auto flex items-end gap-3">
                        <I18NDebug key={skill.experience_years.key}>
                            <p class="text-5xl leading-none">{skill.experience_years.value}</p>
                        </I18NDebug>
                        <I18NDebug key={skill.experience_label.key}>
                            <p class="text-[0.88rem] opacity-50 leading-tight max-w-28">
                                {skill.experience_label.value}
                            </p>
                        </I18NDebug>
                    </div>
                </article>
            ))
        }
    </div>
</section>
