---
import I18NDebug from "@ariaskit/astro-i18n/I18NDebug.astro";

type Option = { key: string; value: string | number };

interface Content {
    title: Option;
    category: Option;
    description: Option;
    experience_years: Option;
    experience_label: Option;
}

interface Props {
    heading: Option;
    content: Content[];
}

const { heading, content } = Astro.props as Props;
---

<section class="mt-20">
    <I18NDebug key={heading.key}>
        <h2 class="opacity-50 uppercase mb-6">{heading.value}</h2>
    </I18NDebug>
    <div class="grid grid-cols-1 gap-px md:grid-cols-3">
        {
            content.map((skill) => (
                <article class="border p-5 min-h-60 flex flex-col">
                    <div class="flex flex-col gap-4">
                        <I18NDebug key={skill.title.key}>
                            <p class="text-green-500 leading-none tracking-tight text-[1.75rem] md:text-[1.3rem] xl:text-[1.5rem] md:whitespace-nowrap">
                                {"> "}
                                {skill.title.value}
                            </p>
                        </I18NDebug>

                        <I18NDebug key={skill.category.key}>
                            <span class="inline-flex w-fit border border-white/15 px-2 py-1 text-[0.68rem] text-white/70 uppercase leading-none">
                                {skill.category.value}
                            </span>
                        </I18NDebug>

                        <I18NDebug key={skill.description.key}>
                            <p class="text-[0.82rem] opacity-50 leading-7 line-clamp-3 min-h-[5.25rem]">
                                {skill.description.value}
                            </p>
                        </I18NDebug>
                    </div>

                    <div class="mt-auto pt-4 border-t flex items-end gap-3">
                        <I18NDebug key={skill.experience_years.key}>
                            <p class="text-4xl leading-none">{skill.experience_years.value}</p>
                        </I18NDebug>
                        <I18NDebug key={skill.experience_label.key}>
                            <p class="text-[0.78rem] opacity-50 leading-tight max-w-24">
                                {skill.experience_label.value}
                            </p>
                        </I18NDebug>
                    </div>
                </article>
            ))
        }
    </div>
</section>
